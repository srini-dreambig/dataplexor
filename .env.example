# ── Content database (Neon Postgres) ─────────────────────────────────
# Required on Vercel (serverless filesystem is read-only).
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Without it, content is read from / written to local JSON files in content/.
DATABASE_URL=

# ── Admin authentication — set all three in production ────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string

# Google Search Console HTML-tag verification (optional)
GOOGLE_SITE_VERIFICATION=
